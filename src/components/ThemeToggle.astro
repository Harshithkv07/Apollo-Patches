---
// Flips between the night side (the default, with the starfield) and the day
// side. The choice is remembered per browser.
---

<button class="theme-toggle" type="button" aria-label="Switch to light theme" data-theme-toggle>
	<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
		<circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
		<path class="lit" d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
	</svg>
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const root = document.documentElement;
	const current = () => (root.dataset.theme === 'light' ? 'light' : 'dark');
	const sync = () => {
		const next = current() === 'dark' ? 'light' : 'dark';
		button?.setAttribute('aria-label', `Switch to ${next} theme`);
		button?.setAttribute('data-current', current());
	};
	button?.addEventListener('click', () => {
		const next = current() === 'dark' ? 'light' : 'dark';
		if (next === 'light') root.dataset.theme = 'light';
		else delete root.dataset.theme;
		try {
			localStorage.setItem('apollo-theme', next);
		} catch {}
		sync();
	});
	sync();
</script>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 1px solid var(--hair);
		border-radius: 50%;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
		transition: border-color 0.2s;
	}

	.theme-toggle:hover {
		border-color: var(--ink);
	}

	.theme-toggle svg {
		transition: transform 0.5s var(--ease);
	}

	.theme-toggle[data-current='dark'] svg {
		transform: rotate(180deg);
	}
</style>
